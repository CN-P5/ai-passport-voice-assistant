<Window x:Class="AiPassportVoice.App.ConfirmExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="停止智能语音"
        Width="380" Height="184"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1" CornerRadius="12" Padding="18"
            MouseLeftButtonDown="OnDrag">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="停止智能语音并退出？" FontSize="14" FontWeight="Medium"
                       Foreground="{DynamicResource TextBrush}"/>

            <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap"
                       Style="{StaticResource HintStyle}"
                       Text="退出会停止语音转发，设备端需重新连接；最小化到托盘可保持后台运行。"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="106" Style="{StaticResource GhostButtonStyle}"
                        Click="OnCancel" Margin="0,0,8,0"/>
                <Button Content="最小化到托盘" Width="106" Style="{StaticResource MinorButtonStyle}"
                        Click="OnMinimize" Margin="0,0,8,0"/>
                <Button Content="退出" Width="106" Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnExit"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
